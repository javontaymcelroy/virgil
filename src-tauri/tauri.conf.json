{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virgil",
  "version": "0.1.0",
  "identifier": "io.github.javontaymcelroy.virgil",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Virgil",
        "width": 1240,
        "height": 900,
        "minWidth": 560,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com vtheme: http://vtheme.localhost; font-src 'self' data: https://fonts.gstatic.com vtheme: http://vtheme.localhost; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.productivity",
    "copyright": "Copyright © 2026 Javontay McElroy. MIT License.",
    "shortDescription": "RSVP speed reader",
    "longDescription": "Virgil shows text one word at a time at the pace you choose. Paste text or open a .txt, .md, .pdf or .epub file.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
